# Get API_ID / API_HASH from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Channel(s) to track. Comma separated. Username, t.me link, or -100... id.
TG_CHANNELS=free_fx_chat

# How many messages to pull on the very first sync (per channel)
FIRST_SYNC_LIMIT=800

# Download attached EA files (.ex4/.ex5/.mq4/.set/.zip) into data/files
DOWNLOAD_FILES=true
MAX_FILE_MB=25

# Web server
PORT=8787

# Auto-sync every N minutes while the server runs (0 = off)
SYNC_INTERVAL_MIN=15
